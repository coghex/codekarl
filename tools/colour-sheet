#!/usr/bin/env python3
"""Write the CK-427 colour sheet and contrast report using the game's Rust derivation."""
import argparse
import colorsys
import pathlib
import subprocess
import struct
import zlib

ROOT = pathlib.Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("png", type=pathlib.Path)
parser.add_argument("report", type=pathlib.Path)
args = parser.parse_args()

bases = []
for saturation in (0.35, 0.80):
    for light in (0.15, 0.30, 0.45, 0.60, 0.75, 0.90):
        for hue in range(0, 360, 15):
            values = colorsys.hls_to_rgb(hue / 360, light, saturation)
            bases.append("#" + "".join(f"{int(v * 255 + 0.5):02x}" for v in values))
bases += ["#6e130f", "#4fb3c8", "#6e130f", "#c9932e", "#000000", "#ffffff", "#808080", "#666666", "#ff0000", "#00ff00", "#0000ff", "#ffff00", "#ece3cb"]
result = subprocess.run([str(ROOT / "tools/ck"), "cargo", "run", "--quiet", "-p", "codekarl", "--bin", "colour-sheet-data", "--", str(ROOT / "assets/ui/theme.toml")], input="\n".join(bases) + "\n", text=True, capture_output=True, check=True, cwd=ROOT)
rows = [line.split() for line in result.stdout.splitlines()]
if len(rows) != len(bases):
    raise RuntimeError("derivation returned the wrong number of rows")
cell_w, cell_h, columns = 180, 92, 8
width, height = columns * cell_w, ((len(rows) + columns - 1) // columns) * cell_h
pixels = bytearray(bytes.fromhex("15110a") * width * height)
# A compact 5-by-7 font for the sheet's fixed labels and hexadecimal values.
glyphs = {
    "0": "01110100011001110101110011000101110", "1": "00100011000010000100001000010001110",
    "2": "01110100010000100010001000100011111", "3": "11110000010000101110000010000111110",
    "4": "00010001100101010010111110001000010", "5": "11111100001000011110000010000111110",
    "6": "01110100001000011110100011000101110", "7": "11111000010001000100010000100001000",
    "8": "01110100011000101110100011000101110", "9": "01110100011000101111000010000101110",
    "A": "01110100011000111111100011000110001", "B": "11110100011000111110100011000111110",
    "C": "01111100001000010000100001000001111", "D": "11110100011000110001100011000111110",
    "E": "11111100001000011110100001000011111", "F": "11111100001000011110100001000010000",
    "H": "10001100011000111111100011000110001", "I": "01110001000010000100001000010001110",
    "L": "10000100001000010000100001000011111", "O": "01110100011000110001100011000101110",
    "P": "11110100011000111110100001000010000", "R": "11110100011000111110101001001010001",
    "S": "01111100001000001110000010000111110", "T": "11111001000010000100001000010000100",
    "U": "10001100011000110001100011000101110", "V": "10001100011000110001100010101000100",
    "N": "10001110011010110011100011000110001", "#": "01010111110101001010111110101001010",
}

def rectangle(x1, y1, x2, y2, colour):
    rgb = bytes.fromhex(colour[1:7])
    line = rgb * (x2 - x1 + 1)
    for yy in range(y1, y2 + 1):
        start = (yy * width + x1) * 3
        pixels[start:start + len(line)] = line

def text(x, y, content, colour):
    for ch in content.upper():
        pattern = glyphs.get(ch)
        if pattern:
            for index, bit in enumerate(pattern):
                if bit == "1": rectangle(x + index % 5, y + index // 5, x + index % 5, y + index // 5, colour)
        x += 6

def write_png(path):
    def chunk(kind, data):
        payload = kind + data
        return struct.pack(">I", len(data)) + payload + struct.pack(">I", zlib.crc32(payload))
    raw = b"".join(b"\x00" + pixels[y * width * 3:(y + 1) * width * 3] for y in range(height))
    path.write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))

def luminance(colour):
    rgb = [int(colour[i:i+2], 16) / 255 for i in (1, 3, 5)]
    rgb = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in rgb]
    return sum(a * b for a, b in zip(rgb, (0.2126, 0.7152, 0.0722)))

def contrast(a, b):
    x, y = sorted((luminance(a), luminance(b)))
    return (y + 0.05) / (x + 0.05)

report = []
for i, (base, hot, title, pressed, number, limit) in enumerate(rows):
    x, y = (i % columns) * cell_w, (i // columns) * cell_h
    states = [("title", base, title), ("hover label", base, title), ("hover number", base, number),
              ("hover over limit", base, limit), ("pressed label", hot, pressed),
              ("pressed number", hot, number), ("pressed over limit", hot, limit), ("button", hot, pressed)]
    for state, fill, ink in states:
        ratio = contrast(fill, ink)
        if ratio < 3:
            report.append(f"{i+1} {base} {state}: ink {ink} fill {fill} {ratio:.2f}:1")
    rectangle(x+2, y+2, x+cell_w-3, y+19, base)
    text(x+5, y+6, f"title {base}", title)
    for offset, fill, ink, label in ((21, base, title, "hover"), (41, hot, pressed, "pressed")):
        rectangle(x+2, y+offset, x+cell_w-3, y+offset+18, fill)
        text(x+5, y+offset+5, label, ink)
        text(x+83, y+offset+5, "123", number)
        text(x+124, y+offset+5, "999", limit)
    rectangle(x+5, y+64, x+68, y+82, hot)
    text(x+9, y+69, "button", pressed)
write_png(args.png)
args.report.write_text("\n".join(report) + ("\n" if report else ""))
